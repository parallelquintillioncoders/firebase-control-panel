# Set these environment variables in your shell or hosting environment.
# This project intentionally does not auto-load this file.
PORT=4183
HOST=127.0.0.1
# Required if binding to anything other than loopback.
DASHBOARD_TOKEN=replace-with-a-long-random-password
# Alternative to running `firebase login` locally (point to a secure server-side key path)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
# Directory for local uploads/history; default is ./data
# PANEL_DATA_DIR=/absolute/path/to/private/data
